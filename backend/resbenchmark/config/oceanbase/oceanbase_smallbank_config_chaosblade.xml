<?xml version="1.0"?>
<parameters xmlns:xi="http://www.w3.org/2001/XInclude">

    <!-- Connection details -->
    <type>OCEANBASE</type>
    <driver>com.mysql.cj.jdbc.Driver</driver>
    <url>jdbc:mysql://YOUR_DB_HOST:2881,YOUR_DB_HOST:2881,YOUR_DB_HOST:2881/oceanbase?useSSL=false&amp;useUnicode=true&amp;characterEncoding=utf-8</url>
    <nodes>
        <node>jdbc:mysql://YOUR_DB_HOST:2881/oceanbase</node>
        <node>jdbc:mysql://YOUR_DB_HOST:2881/oceanbase</node>
        <node>jdbc:mysql://YOUR_DB_HOST:2881/oceanbase</node>
    </nodes>
    <username>root@sys</username>
    <password>YOUR_PASSWORD</password>
    <reconnectOnConnectionFailure>true</reconnectOnConnectionFailure>
    <isolation>TRANSACTION_READ_COMMITTED</isolation>
    <batchsize>128</batchsize>

    <scalefactor>1</scalefactor>
    <data_cktype>ONLY_SPECIAL</data_cktype> <!-- ALL_DATA | ONLY_SPECIAL -->

    <!-- The workload -->
    <terminals>100</terminals>

    <faultCases>
        <case>
            <id>1</id>
            <description>CPU Overload</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>cpu</arg>
                <arg>fullload</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>cpu</arg>
                <arg>fullload</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>2</id>
            <description>Disk Full</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>disk</arg>
                <arg>fill</arg>
                <arg>--path</arg>
                <arg>/home</arg>
                <arg>--percent</arg>
                <arg>100</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>disk</arg>
                <arg>fill</arg>
                <arg>--path</arg>
                <arg>/home</arg>
                <arg>--percent</arg>
                <arg>100</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>3</id>
            <description>Memory Full</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>mem</arg>
                <arg>load</arg>
                <arg>--mode</arg>
                <arg>ram</arg>
                <arg>--mem-percent</arg>
                <arg>100</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>mem</arg>
                <arg>load</arg>
                <arg>--mode</arg>
                <arg>ram</arg>
                <arg>--mem-percent</arg>
                <arg>100</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>4</id>
            <description>Network Loss 10%</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>network</arg>
                <arg>loss</arg>
                <arg>--percent</arg>
                <arg>10</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>network</arg>
                <arg>loss</arg>
                <arg>--percent</arg>
                <arg>10</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>5</id>
            <description>Network Latency 100ms</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>network</arg>
                <arg>delay</arg>
                <arg>--time</arg>
                <arg>100</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>network</arg>
                <arg>delay</arg>
                <arg>--time</arg>
                <arg>100</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>6</id>
            <description>Network Loss 30%</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>network</arg>
                <arg>loss</arg>
                <arg>--percent</arg>
                <arg>30</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>network</arg>
                <arg>loss</arg>
                <arg>--percent</arg>
                <arg>30</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>7</id>
            <description>Network Latency 300ms</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>network</arg>
                <arg>delay</arg>
                <arg>--time</arg>
                <arg>300</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>network</arg>
                <arg>delay</arg>
                <arg>--time</arg>
                <arg>300</arg>
                <arg>--interface</arg>
                <arg>enp4s0f1</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>8</id>
            <description>I/O Read High Payload</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>disk</arg>
                <arg>burn</arg>
                <arg>--read</arg>
                <arg>--path</arg>
                <arg>/home</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>disk</arg>
                <arg>burn</arg>
                <arg>--read</arg>
                <arg>--path</arg>
                <arg>/home</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>9</id>
            <description>I/O Write High Payload</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>disk</arg>
                <arg>burn</arg>
                <arg>--write</arg>
                <arg>--path</arg>
                <arg>/home</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>disk</arg>
                <arg>burn</arg>
                <arg>--write</arg>
                <arg>--path</arg>
                <arg>/home</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>10</id>
            <description>I/O Read/Write High Payload</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>disk</arg>
                <arg>burn</arg>
                <arg>--read</arg>
                <arg>--write</arg>
                <arg>--path</arg>
                <arg>/home</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>disk</arg>
                <arg>burn</arg>
                <arg>--read</arg>
                <arg>--write</arg>
                <arg>--path</arg>
                <arg>/home</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>11</id>
            <description>OceanBase Process Hang</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>process</arg>
                <arg>stop</arg>
                <arg>--process-cmd</arg>
                <arg>observer</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>process</arg>
                <arg>stop</arg>
                <arg>--process-cmd</arg>
                <arg>observer</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>12</id>
            <description>OceanBase Process Shutdown</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>process</arg>
                <arg>kill</arg>
                <arg>--process-cmd</arg>
                <arg>observer</arg>
                <arg>--signal</arg>
                <arg>9</arg>
            </injection>
            <recovery>
                <cmd>bash</cmd>
                <arg>scripts/process_start_oceanbase.sh</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>31</id>
            <description>time travel</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>time</arg>
                <arg>travel</arg>
                <arg>--offset</arg>
                <arg>30m00s</arg>
            </injection>
            <recovery>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>destroy</arg>
                <arg>time</arg>
                <arg>travel</arg>
                <arg>--offset</arg>
                <arg>30m00s</arg>
            </recovery>
            <autoRecovery>0</autoRecovery>
        </case>
        <case>
            <id>32</id>
            <description>OS reboot</description>
            <agents>
                <agent>YOUR_DB_HOST:8000</agent>
            </agents>
            <injection>
                <cmd>/opt/chaosblade/blade</cmd>
                <arg>create</arg>
                <arg>shutdown</arg>
                <arg>reboot</arg>
                <arg>--force</arg>
            </injection>
            <autoRecovery>1</autoRecovery>
        </case>
    </faultCases>

    <xi:include href="../smallbank-worker.xml" parse="xml"/>
    <!-- SmallBank Procedures declaration -->
    <transactiontypes>
        <transactiontype>
            <name>Amalgamate</name>
        </transactiontype>
        <transactiontype>
            <name>Balance</name>
        </transactiontype>
        <transactiontype>
            <name>DepositChecking</name>
        </transactiontype>
        <transactiontype>
            <name>SendPayment</name>
        </transactiontype>
        <transactiontype>
            <name>TransactSavings</name>
        </transactiontype>
        <transactiontype>
            <name>WriteCheck</name>
        </transactiontype>
    </transactiontypes>
</parameters>
