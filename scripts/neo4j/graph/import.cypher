CREATE (n5)-[:`RELATES_TO` {`applicability_basis`: "user_confirmed_fixed_file_scenario", `compile_enabled`: true, `created_at`: datetime("2026-09-23T17:18:57.198Z"), `description`: "In the user's fixed-file scenario, file move and file permission change must not have overlapping declared intervals.", `evidence_hashes`: ["5EFC5C8844250053F1E11046EE72C323DAA0101F935330D96E14F64E817613AA", "895682BA012E2DB8F797975D598FA6F5E9DFC234D707A7A3ACD3448C2AD87044"], `evidence_ref`: "user-request-2026-11-03-fixed-file-target", `evidence_type`: "user_defined_plan_contract", `example_only`: false, `exclusions`: [], `fixed_scenario_original_description`: "The reviewed scripts may share one recovery-record path but store incompatible record formats. Overlapping ownership must be excluded for these executor versions.", `fixed_scenario_original_evidence_ref`: "agent/scripts/file_mv_fault.sh;agent/scripts/file_chmod_fault.sh", `fixed_scenario_original_evidence_type`: "executor_contract", `fixed_scenario_original_exclusions`: ["Different recovery-record paths or filesystem namespaces", "Revised executors with separate records and coordinated file operations"], `fixed_scenario_original_preconditions`: ["Both instances use the reviewed file scripts", "Both resolve to the same recovery-record path in the same filesystem namespace", "Ownership intervals from injection through completed recovery overlap"], `fixed_scenario_original_scope`: "same_recovery_record_current_file_scripts", `formalization_batch`: "user-formalization-20261101-8464c8f097", `formalization_date`: "2026-11-01", `formalization_note`: "User-designated formal rule for experiment configuration. This status change is not empirical validation or proof of complete scope implementation; original evidence and timing requirements remain unchanged.", `formalization_source`: "explicit_user_request", `graph_version`: "resbench-kg-v1", `id`: "review-20260923-file-move-mutex-permission-recovery-record", `limitations`: "This scenario policy does not claim that same-file operations inherently conflict, or that current injectors necessarily use the reviewed recovery scripts.", `mechanism`: "Enforce the scenario's non-overlap scheduling policy. The user guarantees the same file target; shared recovery-record or executor identity is not inferred.", `observation_metrics`: ["recovery_record_integrity", "restored_path", "restored_permissions"], `policy_revision`: "user-request-20261103-fixed-file-target-v1", `preconditions`: [], `relation`: "mutually_exclusive", `relation_layer`: "scenario_constraint", `review_batch`: "review-20260923", `review_status`: "user_confirmed_fixed_scenario", `runtime_effects_verified`: false, `scenario_assumptions`: ["file_events_target_same_file", "overlapping_file_move_and_permission_change_disallowed_by_scenario_policy"], `scope`: "", `scope_confirmation_source`: "user-request-2026-11-03", `scope_implementation`: "fixed_scenario_no_plan_gate", `scope_implemented`: true, `source`: "file_move", `target`: "file_permission_change", `timing_mode`: "exclusive_ownership", `timing_status`: "executor_lifecycle_defined", `validation_plan`: "In an isolated fixture, verify resolved record paths and the two record parsers; require serialization until both recovery actions complete.", `validation_status`: "validated"}]->(n6)
