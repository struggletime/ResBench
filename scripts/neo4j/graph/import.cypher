CREATE (n8)-[:`RELATES_TO` {`applicability_basis`: "user_assured_fixed_experimental_scenario", `compile_enabled`: true, `created_at`: datetime("2026-09-23T17:18:57.198Z"), `description`: "Memory reclaim may amplify the service impact of a verified rollback workload; it does not imply that memory exhaustion always makes rollback expensive.", `evidence_ref`: "agent/scripts/java/MassiveRollbackTest.java:runLoad;mechanism-review", `evidence_type`: "hypothesis", `example_only`: false, `exclusions`: [], `fixed_scenario_original_exclusions`: ["Rollback sessions fail to connect or never perform rollbacks", "Backpressure substantially reduces actual rollback work", "Database implements cheap aborts for the tested temporary-table workload and no positive interaction is measured"], `fixed_scenario_original_preconditions`: ["Rollback injector has live sessions and confirmed successful rollback operations", "Memory pressure affects the same database allocation or reclaim domain", "Rollback rate and transaction work are recorded and controlled", "Database stays alive without a saturated service-loss floor"], `fixed_scenario_original_scope`: "same_db_memory_budget_with_active_rollback_work", `formalization_batch`: "user-formalization-20261101-8464c8f097", `formalization_date`: "2026-11-01", `formalization_note`: "User-designated formal rule for experiment configuration. This status change is not empirical validation or proof of complete scope implementation; original evidence and timing requirements remain unchanged.", `formalization_source`: "explicit_user_request", `graph_version`: "resbench-kg-v1", `id`: "review-20260923-memory-enhances-massive-rollback", `interaction_interpretation`: "potential_plan_interaction_under_user_assured_conditions", `mechanism`: "Memory pressure may slow transaction processing through reclaim or allocation stalls while rollback work competes with foreground transactions.", `observation_metrics`: ["foreground_goodput", "foreground_timeout_rate", "comp