CREATE (n15)-[:`RELATES_TO` {`activation_checks`: ["target_service_unavailable", "filesystem_free_bytes", "write_failure_enospc"], `applicability_basis`: "user_assured_fixed_experimental_scenario", `compile_enabled`: true, `created_at`: datetime("2026-09-23T17:18:57.198Z"), `description`: "Complete service termination may hide the incremental disk-full effect in successful transaction throughput while the service remains down.", `evidence_ref`: "agent/scripts/process_shutdown.sh;service-goodput-floor-mechanism-review", `evidence_type`: "hypothesis", `example_only`: false, `exclusions`: [], `fixed_scenario_original_exclusions`: ["Termination frees deleted-but-open files and clears disk exhaustion", "Automatic restart or failover restores service in the observation window", "Disk capacity, error cause, restart success or recovery time is being compared"], `fixed_scenario_original_preconditions`: ["Termination makes the measured service unavailable with no failover", "Disk-full state is independently verified and persists after process termination", "Disk-full alone affects a write workload on the relevant filesystem", "Observation excludes restart and recovery and uses successful transaction throughput"], `fixed_scenario_original_scope`: "fully_terminated_service_with_persistent_disk_full", `formalization_batch`: "user-formalization-20261101-8464c8f097", `formalization_date`: "2026-11-01", `formalization_note`: "User-designated formal rule for experiment configuration. This status change is not empirical validation or proof of complete scope implementation; original evidence and timing requirements remain unchanged.", `formalization_source`: "explicit_user_request", `graph_version`: "resbench-kg-v1", `id`: "review-20260923-terminate-masks-disk-full-service-goodput", `interaction_interpretation`: "potential_plan_interaction_under_user_assured_conditions", `mechanism`: "Successful throughput is already zero during complete service downtime; persistent disk exhaustion cannot further reduce that metric.", `observation_metrics`: ["foreground_goodput"], `policy_revision`: "user-request-20261103-fixed-interaction-conditions-v1", `preconditions`: [], `relation`: "masks", `relation_layer`: "observation_interaction", `review_batch`: "review-20260923", `review_status`: "mechanism_reviewed", `runtime_effects_verified`: false, `scenario_assumptions`: ["original_scope_and_required_conditions_are_satisfied", "original_exclusion_conditions_do_not_apply"], `scope`: "", `scope_confirmation_limit`: "Applies only to the fixed experimental scenario assured by the user. Restore original predicates for other scenarios.", `scope_confirmation_source`: "user-request-2026-11-03", `scope_implementation`: "fixed_scenario_no_plan_gate", `scope_implemented`: true, `source`: "process_terminate", `target`: "disk_full", `timing_mode`: "overlap", `timing_status`: "uncalibrated", `validation_plan`: "Verify capacity exhaustion throughout the combined interval; compare four conditions for successful throughput, and evaluate restart or recovery separately.", `validation_status`: "validated"}]->(n3)
CREATE (n0)-[:`RELATES_TO` {`applicability_basis`: "user_assured_storm_induced_exhaustion_scenario", `compile_enabled`: true, `created_at`: datetime("2026-11-01T11:03:31.510Z"), `description`: "For the storm-induced exhaustion scenario only, the connection storm must be active when the connection-exhaustion interval begins and must use the same database connection budget.", `evidence_ref`: "user-request-2026-11-01", `evidence_type`: "user_defined_scenario_contract", `example_only`: false, `exclusions`: [], `fixed_scenario_original_exclusions`: ["independent_connection_exhaustion"], `fixed_scenario_original_preconditions`: ["storm_induced_exhaustion_scenario", "storm_retains_connections"], `fixed_scenario_original_scope`: "same_database+same_connection_budget", `formalization_batch`: "user-formalization-20261101-8464c8f097", `formalization_date`: "2026-11-01", `formalization_note`: "User-designated formal rule for experiment configuration. This status change is not empirical validation or proof of complete scope implementation; original evidence and timing requirements remain unchanged.", `formalization_source`: "explicit_user_request", `graph_version`: "resbench-kg-v1", `id`: "review-20261101-connection-exhaustion-depends-on-connection-storm", `limitations`: "This is a construction prerequisite, not a universal causal law. Exhaustion may have other causes and may persist after storm injection ends.", `mechanism`: "Admitted connections retained by the storm consume the configured connection budget. Connection attempts alone do not prove exhaustion.", `policy_revision`: "user-request-20261103-fixed-dependency-conditions-v1", `preconditions`: [], `relation`: "depends_on", `relation_layer`: "scenario_prerequisite", `required_state`: "active_at_start", `review_batch`: "user-request-20261101", `review_status`: "user_confirmed_fixed_scenario", `runtime_effects_verified`: false, `scenario_assumptions`: ["same_database", "same_connection_budget", "storm_induced_exhaustion_scenario", "storm_retains_connections", "independent_connection_exhaustion_does_not_apply"], `scope`: "", `scope_confirmation_limit`: "These conditions are user-assured for this experimental scenario. Restore original predicates for other scenarios.", `scope_confirmation_source`: "user-request-2026-11-03", `scope_implementation`: "fixed_scenario_no_plan_gate", `scope_implemented`: true, `timing_status`: "scenario_defined", `validation_plan`: "Review the shared connection budget, retained-session behavior, and measured exhaustion in an isolated environment before enabling formal checks. Active-at-start is the selected scenario convention, not a measured universal duration.", `validation_status`: "validated"}]->(n1)
