CREATE (n9)-[:`RELATES_TO` {`applicability_basis`: "user_assured_fixed_experimental_scenario", `compile_enabled`: true, `created_at`: datetime("2026-09-23T17:18:57.198Z"), `description`: "Additional delay may amplify the application impact of packet loss when recovery of the affected TCP flows depends on RTT or retransmission timeouts.", `evidence_ref`: "tcp-loss-recovery-mechanism-review", `evidence_type`: "hypothesis", `example_only`: false, `exclusions`: [], `fixed_scenario_original_exclusions`: ["Impairments affect unrelated traffic", "One network rule overwrites the other", "Cached or local operations bypass the affected network", "Complete packet loss or timeout saturation hides any incremental effect"], `fixed_scenario_original_preconditions`: ["Both impairments are simultaneously effective on the same relevant TCP flows", "The injector supports composing delay and loss without replacing either rule", "Application traffic remains active and loss is below complete disconnection", "Actual RTT and drop rate are measured"], `fixed_scenario_original_scope`: "same_tcp_flow_with_rtt_sensitive_loss_recovery", `formalization_batch`: "user-formalization-20261101-8464c8f097", `formalization_date`: "2026-11-01", `formalization_note`: "User-designated formal rule for experiment configuration. This status change is not empirical validation or proof of complete scope implementation; original evidence and timing requirements remain unchanged.", `formalization_source`: "explicit_user_request", `graph_version`: "resbench-kg-v1", `id`: "review-20260923-delay-enhances-packet-loss", `interaction_interpretation`: "potential_plan_interaction_under_user_assured_conditions", `mechanism`: "A longer feedback or retransmission cycle may increase the application cost of recovering lost data. This concerns loss impact, not an increase in the injected drop probability.", `observation_metrics`: ["foreground_goodput", "foreground_timeout_rate", "tcp_rtt", "observed_drop_rate", "tcp_retransmi