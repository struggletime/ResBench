CREATE (n14)-[:`RELATES_TO` {`applicability_basis`: "user_confirmed_fixed_target_scenario", `compile_enabled`: true, `created_at`: datetime("2026-11-03T08:23:44.617Z"), `description`: "In the user's fixed shared-process-target scenario, suspension and termination must not have overlapping declared intervals.", `evidence_ref`: "user-request-2026-11-03", `evidence_type`: "user_defined_plan_contract", `example_only`: false, `exclusions`: [], `experimental_validation_status`: "not_experimentally_validated", `graph_version`: "resbench-kg-v1", `id`: "review-20261103-mutex-process_suspend-process_terminate", `limitations`: "This policy assumes the fixed process target. Restore applicability checks before using the rule in scenarios with different process instances.", `mechanism`: "The scenario prohibits overlapping suspension and termination of the same process instance, whose identity is guaranteed by the user.", `min_overlap_ms`: 0, `policy_revision`: "user-request-20261103-fixed-targets-v1", `preconditions`: [], `relation`: "mutually_exclusive", `relation_layer`: "scenario_constraint", `review_batch`: "user-request-20261103-conditional-mutex", `review_status`: "user_confirmed_fixed_scenario", `scenario_assumptions`: ["process_events_target_same_process_instance", "overlapping_suspension_and_termination_disallowed_by_scenario_policy"], `scope`: "", `scope_implementation`: "fixed_scenario_no_plan_gate", `scope_implemented`: true, `symmetric`: true, `timing_status`: "scenario_defined", `validation_plan`: "Check positive interval overlap against the declared plan policy; runtime impairment behavior is assessed separately.", `validation_status`: "validated"}]->(n15);
